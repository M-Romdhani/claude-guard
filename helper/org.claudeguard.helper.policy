<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC
 "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1.0/policyconfig.dtd">
<policyconfig>
  <vendor>Claude Guard</vendor>
  <vendor_url>https://github.com/M-Romdhani/claude-guard</vendor_url>

  <action id="org.claudeguard.helper.run">
    <description>Apply a Claude Guard system fix</description>
    <message>Authentication is required to change system security settings</message>
    <defaults>
      <!-- Local, active session only. Never remote, never idle, never silent. -->
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <!-- auth_admin, not auth_admin_keep: every action re-authenticates.
           A cached credential in a tool that runs sudo commands is exactly the
           thing an attacker with brief local access would wait for. -->
      <allow_active>auth_admin</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/libexec/claude-guard-helper</annotate>
    <annotate key="org.freedesktop.policykit.exec.allow_gui">true</annotate>
  </action>
</policyconfig>
